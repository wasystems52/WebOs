# Nome da Aplicação
spring.application.name=os

# Nova porta para evitar o erro "Port 8080 was already in use"
server.port=${port:8085}

# Configurações do Console H2
spring.h2.console.enabled=true
spring.h2.console.path=/h2-console

# URL do Banco em Arquivo (Dados não somem ao reiniciar)
spring.datasource.url=jdbc:h2:file:~/test
spring.datasource.username=sa
spring.datasource.password=
spring.datasource.driver-class-name=org.h2.Driver

# Estratégia de criação automática de tabelas
spring.jpa.hibernate.ddl-auto=update
spring.jpa.defer-datasource-initialization=true

# Logs para ver os comandos SQL no console
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true



